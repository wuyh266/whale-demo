# 不填写密钥时，聊天使用明确标注的本地演示回复。
APP_ADDR=127.0.0.1:8787
DATA_DIR=data

# DeepSeek 或其他兼容 Chat Completions 的服务。
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# 可选：兼容 /audio/transcriptions 的语音识别服务。
# 未配置时尝试浏览器语音识别，支持情况取决于浏览器和网络。
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=

# 可选：兼容 /audio/speech 的语音合成服务。
# 未配置时使用设备上的中文朗读声音。
TTS_API_BASE=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=

# 选择 browser / openai / gpt-sovits。留空时保持原来的自动选择行为。
TTS_PROVIDER=
# 本地 GPT-SoVITS，无需 API key，和上面的 OpenAI TTS 配置相互独立。
GPT_SOVITS_API_BASE=http://127.0.0.1:9880
GPT_SOVITS_PROFILE=config/sovits.json
TTS_TIMEOUT_SECONDS=180
